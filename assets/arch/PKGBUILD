# Upstream recipe maintainer: noxygalaxy <noxycraftyt@gmail.com>
# Fork distributor contact remains pending review.
pkgname=lunola-mova
pkgver=${CONCAT_VERSION:?CONCAT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
# Fork homepage/contact pending distributor review; upstream attribution retained above.
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CONCAT_STAGE:?CONCAT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/lunola-mova" "$pkgdir/opt/lunola-mova/lunola-mova"
  install -d "$pkgdir/opt/lunola-mova/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/lunola-mova/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/lunola-mova/lunola-mova "$@"\n' > "$pkgdir/usr/bin/lunola-mova"
  chmod 755 "$pkgdir/usr/bin/lunola-mova"
  install -Dm644 "$stage/app.lunola.mova.desktop" "$pkgdir/usr/share/applications/app.lunola.mova.desktop"
  sed -i 's|^Exec=lunola-mova|Exec=/opt/lunola-mova/lunola-mova %U|' "$pkgdir/usr/share/applications/app.lunola.mova.desktop"
  install -Dm644 "$stage/app.lunola.mova.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/app.lunola.mova.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/lunola-mova/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/lunola-mova/THIRD_PARTY_NOTICES.md"
}
